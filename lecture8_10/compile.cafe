--
-- A compiler for Minila programs
--

--
-- - Function compile takes a Minila program and converts it into
--   an instruction sequence.
-- - Function generator actually does this.
-- - genForExp does this for expression.
--

in vm

mod! COMPILE {
  pr(STM)
  pr(ILIST)
  op compile : Stm -> IList .
  op generate : Stm -> IList .
  op genForExp : Exp -> IList .
  vars E E1 E2 : Exp .
  vars S S1 S2 : Stm .
  var V : Var .
  var N : Nat .
  var IL : IList .

  -- compile
  eq compile(S) = generate(S) @ (quit | iln) .

  -- generate. 文を命令列に変換する
  -- 空の文
  eq generate(estm) = iln .
  -- 代入文
  eq generate(V := E ;) = genForExp(E) @ (store(V) | iln) .
  -- if文
  -- ・まず、genForExp(E)で条件式の結果をスタックに積む
  -- ・次に、jumpOnCond(2)を実行
  -- 　・条件を満たさない場合(Stackに0が積まれている場合)はPCを1進める
  -- 　　・PCを1進めた先の命令はjump(len(generate(S1)) + 2)で、generate(S2)に飛ぶ
  -- 　・条件を満たす場合(Stackに0以外が積まれている場合)はPCを2進めるので、generate(S1)に飛ぶ
  -- 　　・その後、jump(len(generate(S2)) + 1)で、generate(S2)をスキップする
  eq generate(if E {S1} else {S2}) = 
    genForExp(E) @ 
    (jumpOnCond(2) | jump(len(generate(S1)) + 2) | iln) @ 
      generate(S1) @ 
    (jump(len(generate(S2)) + 1) | iln) @ 
      generate(S2) .
  -- while文
  -- ・まず、genForExp(E)で条件式の結果をスタックに積む
  -- ・次に、jumpOnCond(2)を実行
  -- 　・条件を満たさない場合(Stackに0が積まれている場合)はPCを1進める
  -- 　　・PCを1進めた先の命令はjump(len(generate(S)) + 2)で、while文を抜ける
  -- 　・条件を満たす場合(Stackに0以外が積まれている場合)はPCを2進めるので、generate(S)に飛ぶ
  -- 　　・その後、bjump(len(genForExp(E) @ generate(S)) + 2)で、while文の先頭に戻る
  eq generate(while E {S}) = 
    genForExp(E) @ 
    (jumpOnCond(2) | jump(len(generate(S)) + 2) | iln) @ 
      generate(S) @
    (bjump(len(genForExp(E) @ generate(S)) + 2) | iln) .
  -- for文. 等価なwhile文に変換する
  eq generate(for V E1 E2 {S}) = generate(
    V := E1 ; 
    while V < E2 || V === E2 { 
      S
      V := V + n(1) ;
    }
  ) .
  -- 逐次結合
  eq generate(S1 S2) = generate(S1) @ generate(S2) .

  -- genForExp. 式を命令列に変換する
  eq genForExp(n(N)) = push(N) | iln .
  eq genForExp(V) = load(V) | iln .
  eq genForExp(E1 + E2) = genForExp(E1) @ genForExp(E2) @ (add | iln) .
  eq genForExp(E1 * E2) = genForExp(E1) @ genForExp(E2) @ (multiply | iln) .
  eq genForExp(E1 - E2) = genForExp(E1) @ genForExp(E2) @ (minus | iln) .
  eq genForExp(E1 / E2) = genForExp(E1) @ genForExp(E2) @ (divide | iln) .
  eq genForExp(E1 % E2) = genForExp(E1) @ genForExp(E2) @ (mod | iln) .
  eq genForExp(E1 < E2) = genForExp(E1) @ genForExp(E2) @ (lessThan | iln) .
  eq genForExp(E1 > E2) = genForExp(E1) @ genForExp(E2) @ (greaterThan | iln) .
  eq genForExp(E1 === E2) = genForExp(E1) @ genForExp(E2) @ (equal | iln) .
  eq genForExp(E1 =!= E2) = genForExp(E1) @ genForExp(E2) @ (notEqual | iln) .
  eq genForExp(E1 && E2) = genForExp(E1) @ genForExp(E2) @ (and | iln) .
  eq genForExp(E1 || E2) = genForExp(E1) @ genForExp(E2) @ (or | iln) .
}

open COMPILE + VM .
  ops x y z tmp : -> Var .
  
  op p1 : -> Stm .
  eq p1 = x := n(1) ;
          y := n(1) ;
          while y < n(10) || y === n(10) {
            x := x * y ;
            y := y + n(1) ;
          } .
  red run(compile(p1)) .

  op p2 : -> Stm .
  eq p2 = x := n(1) ;
          for y n(1) n(10) {
            x := y * x ;
          } .
  red run(compile(p2)) .

  op p3 : -> Stm .
  eq p3 = x := n(24) ;
          y := n(30) ;
          while y =!= n(0) {
            z := x % y ;
            x := y ;
            y := z ;
          } .
  red run(compile(p3)) .

  op p4 : -> Stm .
  eq p4 = x := n(20000000000000000) ;
          y := n(0) ;
          z := x ;
          while y =!= z {
            if ((z - y) % n(2)) === n(0) {
              tmp := y + (z - y) / n(2) ;
            } else {
              tmp := y + ((z - y) / n(2)) + n(1) ;
            }
            if tmp * tmp > x {
              z := tmp - n(1) ;
            } else {
              y := tmp ;
            }
          } .
  red run(compile(p4)) .
close
