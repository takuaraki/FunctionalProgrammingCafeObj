mod! LIST2 (E :: TRIV) {
  [List]
  op nil : -> List {constr}
  op _|_ : Elt.E List -> List {constr} .

  vars E E2 : Elt.E .
  vars L1 L2 L3 : List .

  -- 等号
  eq (nil = E | L1) = false .
  eq (E | L1 = E2 | L2) = (E = E2) and (L1 = L2) .

  -- 結合
  op _@_ : List List -> List {assoc} .
  eq nil @ L2 = L2 .
  eq (E | L1) @ L2 = E | (L1 @ L2) .

  -- 逆リスト1
  op rev1 : List -> List .
  eq rev1(nil) = nil .
  eq rev1(E | L1) = rev1(L1) @ (E | nil) .

  -- 逆リスト2
  op rev2 : List -> List .
  op sr2 : List List -> List .
  eq rev2(L1) = sr2(L1,nil) .
  eq sr2(nil,L2) = L2 .
  eq sr2(E | L1,L2) = sr2(L1,E | L2) .
}