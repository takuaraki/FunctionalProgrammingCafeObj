in list1

--> 定理1 [_@_ の結合則 (assoc@)]
--> (L1 @ L2) @ L3 = L1 @ (L2 @ L3)
--> 定理1の証明. L1に着目して構造的帰納法を用いる.
-->
--> I. Base case
open LIST1 .
  -- fresh constants
  ops l2 l3 : -> List .
  -- check
  red (nil @ l2) @ l3 = nil @ (l2 @ l3) .
close
-->
--> II. Induction case
open LIST1 .
  -- fresh constants
  ops l1 l2 l3 : -> List .
  op e : -> Elt.E .
  -- induction hypothesis
  eq (l1 @ L2) @ L3 = l1 @ (L2 @ L3) .
  -- check
  red ((e | l1) @ l2) @ l3 = (e | l1) @ (l2 @ l3) .
close
-->
--> 定理1の証明終了
